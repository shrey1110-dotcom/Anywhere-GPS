diff --git a/StikDebug/Services/PairingFormatDiagnostics.swift b/StikDebug/Services/PairingFormatDiagnostics.swift
new file mode 100644
--- /dev/null
+++ b/StikDebug/Services/PairingFormatDiagnostics.swift
@@ -0,0 +1,69 @@
+import Foundation
+import idevice
+
+// Opt-in local diagnostics: records field names and types, never credential values.
+enum PairingFormatDiagnostics {
+    static func runIfRequested() {
+        guard ProcessInfo.processInfo.environment["STIKDEBUG_PAIRING_DIAGNOSTICS"] == "1" else { return }
+        var report: [String: Any] = [:]
+        do {
+            let data = try Data(contentsOf: PairingFileStore.prepareURL())
+            report["inputFields"] = try fields(in: data)
+            var input: OpaquePointer?
+            let error = data.withUnsafeBytes {
+                rp_pairing_file_from_bytes($0.bindMemory(to: UInt8.self).baseAddress, UInt(data.count), &input)
+            }
+            report["nativeReadAccepted"] = error == nil && input != nil
+            if let input { rp_pairing_file_free(input) }
+            if let error {
+                let message = error.pointee.message.map { String(cString: $0) } ?? ""
+                // Do not persist raw error text: a parser could include the offending value.
+                report["parserMentionsSequence"] = message.localizedCaseInsensitiveContains("sequence")
+                report["parserMentionsData"] = message.localizedCaseInsensitiveContains("data")
+                report["parserMentionsMissingField"] = message.localizedCaseInsensitiveContains("missing field")
+                if let range = message.range(of: #"missing field `[A-Za-z_][A-Za-z0-9_]*`"#, options: .regularExpression) {
+                    report["missingField"] = String(message[range])
+                }
+                idevice_error_free(error)
+            }
+
+            var template: OpaquePointer?
+            if let error = rp_pairing_file_generate("StikDebug", &template) {
+                idevice_error_free(error)
+            } else if let template {
+                defer { rp_pairing_file_free(template) }
+                var bytes: UnsafeMutablePointer<UInt8>?
+                var length: UInt = 0
+                if let error = rp_pairing_file_to_bytes(template, &bytes, &length) {
+                    idevice_error_free(error)
+                } else if let bytes {
+                    defer { idevice_data_free(bytes, length) }
+                    report["nativeTemplateFields"] = try fields(in: Data(bytes: bytes, count: Int(length)))
+                }
+            }
+            var url = URL.documentsDirectory.appendingPathComponent("pairing_format_diagnostics.json")
+            try JSONSerialization.data(withJSONObject: report, options: [.sortedKeys])
+                .write(to: url, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+            try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: url.path)
+            var resources = URLResourceValues()
+            resources.isExcludedFromBackup = true
+            try url.setResourceValues(resources)
+        } catch {
+            LogManager.shared.addErrorLog("Local pairing format diagnostic could not finish.")
+        }
+    }
+
+    private static func fields(in data: Data) throws -> [String: String] {
+        guard let record = try PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else { return [:] }
+        return record.mapValues { value in
+            switch value {
+            case let data as Data: return "data(\(data.count))"
+            case let values as [Any]: return "array(\(values.count))"
+            case let text as String: return "string(\(text.count))"
+            case is [String: Any]: return "dictionary"
+            case is NSNumber: return "number"
+            default: return "other"
+            }
+        }
+    }
+}
